          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "storedProcedureName": "[dbo].[updateWatermark_new]",
          "storedProcedureParameters": {
            "datetime": {
              "value": {
                "value": "@activity('Get history watermark').output.firstRow.last_updated",
                "type": "Expression"
              },
              "type": "DateTime"
            },
            "status": {
              "value": "Success",
              "type": "String"
            },
            "tablename": {
              "value": "seriespost",
              "type": "String"
            }
          }
        },
        "linkedServiceName": {
          "referenceName": "LS_SQL",
          "type": "LinkedServiceReference"
        }
      }
