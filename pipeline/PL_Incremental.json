        "userProperties": [],
        "typeProperties": {
          "source": {
            "type": "AzureSqlSource",
            "sqlReaderQuery": "select max(lastUpdated) as last_updated from dbo.SeriesPost_H",
            "queryTimeout": "02:00:00",
            "partitionOption": "None"
          },
          "dataset": {
            "referenceName": "DS_History",
            "type": "DatasetReference"
          }
        }
