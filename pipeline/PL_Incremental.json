            "partitionOption": "None"
          },
          "dataset": {
            "referenceName": "DS_Lah_Stage",
            "type": "DatasetReference"
          }
        }
      },
      {
        "name": "Staging to History",
        "type": "Copy",
        "dependsOn": [
